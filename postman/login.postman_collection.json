{
  "info": {
    "description": "Local validation needs migrated tables. Fixture login must run through verify_login_api.py against its isolated seeded SQLite or PostgreSQL app. Access tokens use real ES256 signatures with an ephemeral PEM key. The verifier checks signatures using the public key returned by HTTP JWKS. The signer-fail account injects a failure before calling the real signer.",
    "name": "Merchant login and ES256 signing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "item": [
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"HTTP 400\", function () { pm.response.to.have.status(400); });",
                  "pm.test(\"No cache\", function () {",
                  "  pm.expect(pm.response.headers.get(\"Cache-Control\")).to.eql(\"no-store\"); });",
                  "pm.test(\"No password echo\", function () {",
                  "  pm.expect(pm.response.text()).not.to.include(\"fixture-only-password\"); });",
                  "pm.test(\"Error envelope\", function () { const data = pm.response.json();",
                  "  pm.expect(data.error.code).to.eql(\"VALIDATION_FAILED\");",
                  "  pm.expect(data.error.requestId).to.match(/^req_/);",
                  "  pm.expect(pm.response.headers.has(\"Set-Cookie\")).to.eql(false);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Missing fields",
          "request": {
            "auth": {
              "type": "noauth"
            },
