HOST=127.0.0.1
PORT=3000
MOCK_AUTH_ENABLED=false
# Local development/test only; enable to use the fixture bearer token below.
MOCK_AUTH_TOKEN=mock-redeem-token
MOCK_AUTH_USER_ID=mock-user
MOCK_AUTH_WALLET_ADDRESS=0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# Configure all three to verify access tokens from #182 with its public key.
# JWT_PUBLIC_KEY_FILE=/run/config/jwt-signing-public.pem
# JWT_ISSUER=https://auth.example.com
# JWT_AUDIENCE=reward-api
