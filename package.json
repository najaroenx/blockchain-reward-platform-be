{
  "name": "blockchain-reward-platform",
  "private": true,
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=10"
  },
  "scripts": {
    "env:init": "node scripts/init-env.mjs",
    "dev": "pnpm -r --parallel --stream run dev",
    "dev:api": "pnpm --filter @app/api run dev",
    "dev:worker": "pnpm --filter @app/worker run dev",
    "dev:indexer": "pnpm --filter @app/indexer run dev",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^13.1.0",
    "@eslint/js": "^10.0.1",
    "@nestjs/core": "12.2.0",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.20",
    "@types/newman": "^5.3.6",
    "@types/node": "^22.18.9",
    "@types/pg": "^8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "^10.13.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "4.16.1",
    "ethers": "^6.17.0",
    "jose": "^6.2.15",
    "newman": "^6.2.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "type": "module"
}