  "info": {
    "description": "Marketplace projections and coupon admission. Redeem admission requires configured adapters; transaction submission is not enabled.",
    "title": "Coupon redeem admission API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/coupons/redeem": {
      "post": {
        "description": "Admit a request for one coupon using a verified user wallet. PENDING acknowledges committed admission, not redemption on chain. Returns 503 until verified auth, deployment, and durable admission adapters are wired.",
        "operationId": "redeemCoupon",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 8,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemCouponRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedeemCouponResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "examples": {
                  "IDEMPOTENCY_KEY_REQUIRED": {
                    "value": {
                      "error": {
                        "code": "IDEMPOTENCY_KEY_REQUIRED",
                        "message": "Idempotency-Key is required."
                      }
                    }
                  },
                  "VALIDATION_FAILED": {
                    "value": {
                      "error": {
                        "code": "VALIDATION_FAILED",
                        "message": "Invalid redeem request."
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/RedeemErrorResponse"
                }
              }
            },
            "description": "Redeem request error."
          },
          "401": {
            "content": {
              "application/json": {
                "examples": {
                  "UNAUTHENTICATED": {
                    "value": {
                      "error": {
                        "code": "UNAUTHENTICATED",
                        "message": "A valid access token is required."
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/RedeemErrorResponse"
                }
              }
            },
            "description": "Redeem request error.",
            "headers": {
              "WWW-Authenticate": {
                "description": "Bearer challenge.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "content": {
              "application/json": {
                "examples": {
                  "WALLET_FORBIDDEN": {
                    "value": {
                      "error": {
                        "code": "WALLET_FORBIDDEN",
                        "message": "No authorized wallet is available for this user."
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/RedeemErrorResponse"
                }
              }
            },
            "description": "Redeem request error."
          },
          "404": {
            "content": {
              "application/json": {
                "examples": {
                  "COUPON_TYPE_NOT_FOUND": {
                    "value": {
                      "error": {
                        "code": "COUPON_TYPE_NOT_FOUND",
                        "message": "Coupon type was not found."
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/RedeemErrorResponse"
                }
              }
            },
            "description": "Redeem request error."
          },
          "409": {
            "content": {
              "application/json": {
                "examples": {
                  "IDEMPOTENCY_KEY_IN_PROGRESS": {
                    "value": {
                      "error": {
                        "code": "IDEMPOTENCY_KEY_IN_PROGRESS",
                        "message": "This request is still in progress."
                      }
                    }
                  },
                  "IDEMPOTENCY_KEY_REUSED": {
                    "value": {
                      "error": {
                        "code": "IDEMPOTENCY_KEY_REUSED",
                        "message": "Idempotency-Key was used for another request."
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/RedeemErrorResponse"
                }
              }
            },
            "description": "Redeem request error."
          },
          "422": {
            "content": {
              "application/json": {
                "examples": {
                  "COUPON_EXPIRED": {
                    "value": {
                      "error": {
                        "code": "COUPON_EXPIRED",
                        "message": "Coupon has expired."
                      }
                    }
                  },
                  "COUPON_NOT_STARTED": {
                    "value": {
                      "error": {
                        "code": "COUPON_NOT_STARTED",
                        "message": "Coupon redemption has not started."
                      }
                    }
                  },
                  "INSUFFICIENT_BALANCE": {
                    "value": {
                      "error": {
                        "code": "INSUFFICIENT_BALANCE",
                        "message": "Coupon balance is insufficient."
                      }
                    }
                  },
                  "NO_REDEEM_CODE_AVAILABLE": {
                    "value": {
                      "error": {
                        "code": "NO_REDEEM_CODE_AVAILABLE",
                        "message": "No redeem code is available."
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/RedeemErrorResponse"
                }
              }
            },
            "description": "Contract business rejection before admission; input validation uses HTTP 400."
          },
          "429": {
            "content": {
              "application/json": {
                "examples": {
                  "RATE_LIMITED": {
                    "value": {
                      "error": {
                        "code": "RATE_LIMITED",
                        "message": "Too many requests."
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/RedeemErrorResponse"
                }
              }
            },
            "description": "Redeem request error.",
            "headers": {
              "Retry-After": {
                "description": "Optional delay in seconds supplied by the rate limiter.",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "500": {
            "content": {
              "application/json": {
                "examples": {
                  "INTERNAL_ERROR": {
                    "value": {
                      "error": {
                        "code": "INTERNAL_ERROR",
                        "message": "The request could not be completed."
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/RedeemErrorResponse"
                }
              }
            },
            "description": "Redeem request error."
          },
          "503": {
            "content": {
              "application/json": {
                "examples": {
                  "ADMISSION_UNAVAILABLE": {
                    "value": {
                      "error": {
                        "code": "ADMISSION_UNAVAILABLE",
                        "message": "Admission storage is unavailable."
                      }
                    }
                  },
                  "CONTRACT_CALL_FAILED": {
                    "value": {
                      "error": {
                        "code": "CONTRACT_CALL_FAILED",
                        "message": "The contract call could not be completed."
                      }
                    }
                  },
                  "REDEEM_UNAVAILABLE": {
                    "value": {
                      "error": {
                        "code": "REDEEM_UNAVAILABLE",
                        "message": "Redeem admission adapters are not configured."
                      }
                    }
                  },
                  "SIGNER_UNAUTHORIZED": {
                    "value": {
                      "error": {
                        "code": "SIGNER_UNAUTHORIZED",
                        "message": "The backend signer is not authorized."
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/RedeemErrorResponse"
                }
              }
            },
            "description": "Redeem request error."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Redeem",
        "tags": [
          "coupons"
        ]
      }
    }
  },
  "servers": [
    {
      "description": "Local development",
      "url": "http://127.0.0.1:3000"
    }
  ]
}
