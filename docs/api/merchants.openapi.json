{
  "components": {
    "schemas": {
      "AdminInput": {
        "additionalProperties": false,
        "properties": {
          "displayName": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Displayname",
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "format": "password",
            "maxLength": 128,
            "minLength": 12,
            "title": "Password",
            "type": "string",
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password",
          "displayName"
        ],
        "title": "AdminInput",
        "type": "object"
      },
      "AdminView": {
        "properties": {
          "adminId": {
            "title": "Adminid",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "adminId",
          "email"
        ],
        "title": "AdminView",
        "type": "object"
      },
      "CreateMerchant": {
        "additionalProperties": false,
        "properties": {
          "admin": {
            "$ref": "#/components/schemas/AdminInput"
          },
          "name": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "name",
          "admin"
        ],
        "title": "CreateMerchant",
        "type": "object"
      },
      "MerchantCreated": {
        "properties": {
          "admin": {
            "$ref": "#/components/schemas/AdminView"
          },
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "merchantId": {
            "title": "Merchantid",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "provisioning": {
            "$ref": "#/components/schemas/ProvisioningView"
          },
          "status": {
            "const": "PENDING",
            "title": "Status",
            "type": "string"
          },
          "wallet": {
            "$ref": "#/components/schemas/WalletView"
          }
        },
        "required": [
          "merchantId",
          "name",
          "status",
          "createdAt",
          "admin",
          "wallet",
          "provisioning"
        ],
        "title": "MerchantCreated",
        "type": "object"
      },
      "ProvisioningView": {
        "properties": {
          "operationId": {
            "title": "Operationid",
            "type": "string"
          },
          "status": {
            "const": "PENDING",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "operationId",
          "status"
        ],
        "title": "ProvisioningView",
        "type": "object"
      },
      "WalletView": {
        "properties": {
          "address": {
            "pattern": "^0x[0-9a-f]{40}$",
            "title": "Address",
            "type": "string"
          },
          "ready": {
            "const": false,
            "title": "Ready",
            "type": "boolean"
          }
        },
        "required": [
          "address",
          "ready"
        ],
        "title": "WalletView",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "Merchant signup",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/merchants": {
      "post": {
        "operationId": "createMerchant",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 8,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMerchant"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MerchantCreated"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input or missing idempotency key."
          },
          "409": {
            "description": "Email or idempotency conflict."
          },
          "429": {
            "description": "Registration rate limit reached.",
            "headers": {
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "4XX": {
            "description": "Client error."
          },
          "503": {
            "description": "Wallet reservation or signup storage is unavailable."
          }
        },
        "summary": "Signup",
        "tags": [
          "merchants"
        ]
      }
    }
  }
}
