  "info": {
    "description": "Marketplace projections, coupon-type persistence, coupon admission, and merchant login. Redeem admission requires configured adapters; transaction submission is not enabled.",
    "title": "Authentication API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/.well-known/jwks.json": {
      "get": {
        "description": "Public ES256 verification keys. Contains no private key material.",
        "operationId": "signingPublicKeys",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JwksResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Public Keys",
        "tags": [
          "authentication"
        ]
      }
    },
    "/v1/auth/login": {
      "post": {
        "description": "Verify merchant-admin credentials. Refresh tokens are sent only in a secure HttpOnly cookie. Configured ES256 signing adds issuer, audience and a JWKS key ID.",
        "operationId": "merchantLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                }
              }
            },
            "description": "Authenticated. Refresh token is sent only in a cookie.",
            "headers": {
              "Set-Cookie": {
