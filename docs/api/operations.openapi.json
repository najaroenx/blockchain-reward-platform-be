  "info": {
    "title": "Operation status",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/operations": {
      "get": {
        "operationId": "listOperations",
        "parameters": [
          {
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "PENDING",
                    "SUBMITTED",
                    "CONFIRMED",
                    "FINALIZED",
                    "CHAIN_REVERTED",
                    "ORPHANED",
                    "MANUAL_REVIEW"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "in": "query",
            "name": "kind",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "MERCHANT_PROVISION",
                    "POINT_TYPE_CREATE",
                    "POINT_TRANSFER",
                    "COUPON_TYPE_CREATE",
                    "COUPON_ISSUE",
                    "COUPON_REDEEM",
                    "LISTING_CREATE",
                    "LISTING_DELETE",
                    "LISTING_BUY",
                    "THB_MINT"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Kind"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "maxLength": 256,
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "description": "Invalid filters or cursor."
          },
          "401": {
            "description": "Access token is missing or invalid."
          },
          "4XX": {
            "description": "Client error."
          },
          "503": {
            "description": "Operation status is unavailable."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "List Operations",
        "tags": [
          "operations"
        ]
      }
    },
    "/v1/operations/{operationId}": {
      "get": {
        "operationId": "getOperation",
        "parameters": [
          {
            "in": "path",
            "name": "operationId",
            "required": true,
            "schema": {
              "title": "Operationid",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "if-none-match",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "If-None-Match"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OperationView"
                }
              }
            },
            "description": "Successful Response",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "schema": {
                  "type": "integer"
                }
              }
            }
          },
          "304": {
            "description": "The event sequence has not changed."
          },
          "401": {
            "description": "Access token is missing or invalid."
          },
          "404": {
            "description": "Operation was not found."
          },
          "4XX": {
            "description": "Client error."
          },
          "503": {
            "description": "Operation status is unavailable."
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Get Operation",
        "tags": [
          "operations"
        ]
      }
    }
  }
}
