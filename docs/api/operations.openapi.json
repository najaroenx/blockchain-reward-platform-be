          }
        },
        "required": [
          "operationId",
          "kind",
          "status",
          "eventSeq",
          "createdAt"
        ],
        "title": "OperationSummary",
        "type": "object"
      },
      "OperationView": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "errorNote": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Errornote"
          },
          "eventSeq": {
            "title": "Eventseq",
            "type": "integer"
          },
