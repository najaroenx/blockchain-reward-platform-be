            "type": "string"
          },
          "txHash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Txhash"
          }
        },
        "required": [
          "index",
          "name",
          "status",
          "txHash"
        ],
        "title": "OperationStepView",
        "type": "object"
      },
      "OperationSummary": {
        "properties": {
          "createdAt": {
            "format": "date-time",
            "title": "Createdat",
            "type": "string"
          },
          "eventSeq": {
            "title": "Eventseq",
            "type": "integer"
          },
          "kind": {
            "title": "Kind",
            "type": "string"
          },
          "operationId": {
            "title": "Operationid",
            "type": "string"
          },
          "status": {
            "enum": [
              "PENDING",
              "SUBMITTED",
              "CONFIRMED",
              "FINALIZED",
              "CHAIN_REVERTED",
              "ORPHANED",
              "MANUAL_REVIEW"
            ],
