                  "FINALIZED",
                  "CHAIN_REVERTED",
                  "ORPHANED",
                  "MANUAL_REVIEW"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fromstatus"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "toStatus": {
            "enum": [
              "PENDING",
              "SUBMITTED",
              "CONFIRMED",
              "FINALIZED",
              "CHAIN_REVERTED",
              "ORPHANED",
              "MANUAL_REVIEW"
            ],
            "title": "Tostatus",
            "type": "string"
          },
          "txHash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
