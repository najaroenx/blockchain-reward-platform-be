# Local development only. Production requires PostgreSQL.
DATABASE_URL=sqlite:///./reward.db
APP_ENV=development
LOG_LEVEL=info

# Docker Compose uses REWARD_DATABASE_URL for an optional PostgreSQL override.
# REWARD_DATABASE_URL=
# REWARD_POSTGRES_PASSWORD=local-development-only
# REWARD_POSTGRES_PORT=5432
# REWARD_CHAIN_NETWORK=blockchain-reward-platform_loaffinity-singlenode
# REWARD_RPC_URL=http://besu-node:8545
# BE0004_POSTGRES_PASSWORD=
