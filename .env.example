# Local development only. Production requires PostgreSQL.
DATABASE_URL=sqlite:///./reward.db
APP_ENV=development
LOG_LEVEL=info

# Leave REWARD_DATABASE_URL unset or empty to start local PostgreSQL with ./start-backend.sh.
# Set it to use a PostgreSQL server that is already running.
# REWARD_DATABASE_URL=postgresql+psycopg://reward:local-development-only@postgres.example:5432/reward
# REWARD_CHAIN_NETWORK=blockchain-reward-platform_loaffinity-singlenode
# REWARD_RPC_URL=http://besu-node:8545
